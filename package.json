{
  "name": "claude-plugins",
  "private": true,
  "type": "module",
  "scripts": {
    "consent:diff": "node scripts/consent-diff.ts",
    "format": "oxfmt 'plugins/**/*.{ts,tsx}' 'scripts/**/*.ts' '*.config.ts'",
    "format:check": "oxfmt --check 'plugins/**/*.{ts,tsx}' 'scripts/**/*.ts' '*.config.ts'",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "setup": "bd bootstrap --yes",
    "test": "vitest run",
    "test:hooks": "claude plugin test plugins/review-cycle && claude plugin test plugins/pr-watch",
    "typecheck": "tsc -p plugins/review-cycle && tsc -p plugins/pr-watch"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.3",
    "@oakoss/oakum": "0.4.0",
    "commitlint": "^21.2.3",
    "lefthook": "^2.1.14",
    "markdownlint-cli2": "^0.23.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.7.0"
}
