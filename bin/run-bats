#!/usr/bin/env bash
# Wrapper around bats that terminates the runner once all results have been
# emitted. Works around a post-suite cleanup hang on macOS where bats holds
# file descriptors open after the final `ok`/`not ok` line.
#
# Always invoke bats through this script, never directly — direct invocations
# leave orphaned bats processes that linger until the OS reaps them.
#
# Given more than one file, the files run concurrently, one bats process each,
# and their TAP streams are merged into a single renumbered plan. This is
# file-level parallelism on purpose: `bats --jobs` interleaves tests *within* a
# file, and these suites plant PATH shims and build fixtures, so the isolation
# that makes them safe to run together is the process boundary they already
# have. Each file runs exactly as it would alone.
#
# Usage:
#   bin/run-bats                                # auto-discover every .bats in the repo
#   bin/run-bats path/to/suite.bats             # run one file
#   bin/run-bats dir/ another/file.bats         # run any combination of files/dirs
#   bin/run-bats -f "test name" path/to.bats    # pass through any bats arg
#
# RUN_BATS_JOBS=1 forces the files through one at a time — an escape hatch for
# diagnosing a suite that only misbehaves alongside others, not a tuning knob.

set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# bats spawns a formatter child (bats-format-cat). Killing the parent doesn't
# signal that child, so it gets reparented to launchd and lingers as an
# orphan. We need to walk the process tree.
kill_tree() {
  local parent="$1" child
  for child in $(pgrep -P "$parent" 2>/dev/null); do
    kill_tree "$child"
  done
  kill -KILL "$parent" 2>/dev/null || true
}

# Runs bats once, to completion or to a stall, writing raw TAP to $1.
# Returns 0 when every planned test reported, 2 otherwise — failures are the
# caller's to count, because a `not ok` is a complete result, not a shortfall.
run_bats_once() {
  local out="$1"; shift
  local bats_pid expected="" last_count=0 last_progress now result_count plan

  bats --tap "$@" > "$out" 2>&1 &
  bats_pid=$!

  # Keyed on inactivity rather than total runtime. A wall-clock budget for the
  # whole run cannot tell a slow suite from a stuck one, so it kills whichever
  # run happens to be longer than the budget — the repo-wide run sat within
  # seconds of the old 120s limit and failed or passed on the coin flip. A hang
  # produces no further output by definition, so silence is the signal.
  local idle_timeout="${RUN_BATS_IDLE_TIMEOUT:-60}"
  last_progress=$(date +%s)

  while :; do
    if ! kill -0 "$bats_pid" 2>/dev/null; then
      wait "$bats_pid" 2>/dev/null
      break
    fi

    if [ -z "$expected" ]; then
      plan=$(grep -a -m1 -E '^1\.\.[0-9]+' "$out" 2>/dev/null || true)
      [ -n "$plan" ] && expected="${plan#1..}"
    fi

    result_count=$(grep -acE '^(ok|not ok) ' "$out" 2>/dev/null || true)
    case "$result_count" in ''|*[!0-9]*) result_count=0 ;; esac

    now=$(date +%s)
    if [ "$result_count" -gt "$last_count" ]; then
      last_count="$result_count"
      last_progress="$now"
    fi

    if [ -n "$expected" ] && [ "$result_count" -ge "$expected" ]; then
      sleep 0.5
      if kill -0 "$bats_pid" 2>/dev/null; then
        # No SIGTERM first: it kills the parent, its children reparent to PID 1,
        # and the walk below then has nothing left to find. Measured, that left
        # three bats processes orphaned while the wrapper exited 0.
        kill_tree "$bats_pid"
      fi
      wait "$bats_pid" 2>/dev/null
      break
    fi

    # Stalled with results still outstanding. Fall through to the reaper below,
    # which kills the tree and reports the shortfall.
    if [ $((now - last_progress)) -ge "$idle_timeout" ]; then
      break
    fi

    sleep 0.2
  done

  # A stall leaves bats alive — reap the tree here too, or the wrapper leaks the
  # exact orphans it exists to prevent.
  if kill -0 "$bats_pid" 2>/dev/null; then
    kill_tree "$bats_pid"
    wait "$bats_pid" 2>/dev/null
  fi

  # Re-derive both values from the file: when bats exits on its own the loop
  # breaks with values from the previous poll — a fast suite can finish before
  # the first poll ever sees the plan line.
  expected=""
  plan=$(grep -a -m1 -E '^1\.\.[0-9]+' "$out" 2>/dev/null || true)
  [ -n "$plan" ] && expected="${plan#1..}"
  [ -n "$expected" ] || return 2

  result_count=$(grep -acE '^(ok|not ok) ' "$out" 2>/dev/null || true)
  case "$result_count" in ''|*[!0-9]*) result_count=0 ;; esac
  [ "$result_count" -ge "$expected" ] || return 2
  return 0
}

# --- argument split -----------------------------------------------------
# Targets are the paths; everything else passes through to bats untouched.
# Existence on disk decides, with one exception: the value of a flag that takes
# one is never a target, however much it looks like a path. `-f tests` is a
# filter, not the tests directory, and reading it as one leaves `-f` dangling.
FLAGS=()
TARGETS=()
want_value=0
FILTERED=0
for arg in "$@"; do
  if [ "$want_value" -eq 1 ]; then
    FLAGS+=("$arg")
    want_value=0
    continue
  fi
  case "$arg" in
    -f|--filter|--negative-filter|--filter-status|--filter-tags|-j|--jobs|\
    -o|--output|-F|--formatter|--report-formatter|--code-quote-style|\
    --parallel-binary-name|--line-reference-format|--gather-test-outputs-in)
      case "$arg" in
        -f|--filter|--negative-filter|--filter-status|--filter-tags) FILTERED=1 ;;
      esac
      FLAGS+=("$arg")
      want_value=1
      continue
      ;;
  esac
  if [ -e "$arg" ]; then
    TARGETS+=("$arg")
    continue
  fi
  # Not a flag and not a path on disk. Passing it to bats emptied TARGETS and
  # fell through to whole-repo discovery, so a typo alongside a real suite ran
  # neither and reported exit 1 -- a failure verdict for a run of nothing.
  case "$arg" in
    -*) FLAGS+=("$arg") ;;
    *) echo "bin/run-bats: no such file: $arg" >&2; exit 2 ;;
  esac
done
for arg in ${FLAGS[@]+"${FLAGS[@]}"}; do
  case "$arg" in
    -p|--pretty|-c|--count|-F|--formatter|--report-formatter)
      echo "bin/run-bats: $arg replaces the TAP output this wrapper reads; run bats directly if you need it" >&2
      exit 2 ;;
  esac
done
if [ "$want_value" -eq 1 ]; then
  echo "bin/run-bats: ${FLAGS[${#FLAGS[@]}-1]} needs a value" >&2
  exit 2
fi

if [ ${#TARGETS[@]} -eq 0 ]; then
  # `mapfile` is bash 4+ only; macOS ships bash 3.2 by default, so use a
  # portable read loop.
  while IFS= read -r bats_file; do
    TARGETS+=("$bats_file")
  done < <(find "$REPO_ROOT" -type f -name '*.bats' \
    -not -path '*/node_modules/*' \
    -not -path '*/.git/*' \
    | sort)
  if [ ${#TARGETS[@]} -eq 0 ]; then
    echo "bin/run-bats: no .bats files found under $REPO_ROOT" >&2
    exit 2
  fi
fi

# Expand directories so every unit of work is one file, which is what makes the
# units independent.
FILES=()
for target in "${TARGETS[@]}"; do
  if [ -d "$target" ]; then
    while IFS= read -r bats_file; do
      FILES+=("$bats_file")
    done < <(find "$target" -type f -name '*.bats' \
      -not -path '*/node_modules/*' -not -path '*/.git/*' | sort)
  else
    FILES+=("$target")
  fi
done

if [ ${#FILES[@]} -eq 0 ]; then
  echo "bin/run-bats: no .bats files among the given targets" >&2
  exit 2
fi

WORK=$(mktemp -d) || {
  echo "bin/run-bats: could not create a work directory (mktemp -d failed)" >&2
  exit 2
}
if [ ! -d "$WORK" ] || [ ! -w "$WORK" ]; then
  echo "bin/run-bats: work directory '$WORK' is not usable" >&2
  exit 2
fi
trap '/bin/rm -rf "$WORK"' EXIT

# --- single file: no merge, no renumbering ------------------------------
if [ ${#FILES[@]} -eq 1 ]; then
  OUT="$WORK/0.tap"
  run_bats_once "$OUT" ${FLAGS[@]+"${FLAGS[@]}"} "${FILES[0]}"
  SHORTFALL=$?
  cat "$OUT"
  PLAN=$(grep -a -m1 -E '^1\.\.[0-9]+' "$OUT" 2>/dev/null || true)
  if [ -z "$PLAN" ]; then
    # `ERROR: Found no tests.` carries no trailing newline, so the `1..0` that
    # follows it never starts a line and the anchored match above misses it.
    if grep -aq 'Found no tests' "$OUT" 2>/dev/null; then
      echo "bin/run-bats: bats found no tests in ${FILES[0]}" >&2
    else
      echo "bin/run-bats: no plan line emitted by bats" >&2
    fi
    exit 2
  fi
  EXPECTED="${PLAN#1..}"
  REPORTED=$(grep -acE '^(ok|not ok) ' "$OUT" 2>/dev/null || true)
  case "$REPORTED" in ''|*[!0-9]*) REPORTED=0 ;; esac
  FAILED=$(grep -acE '^not ok ' "$OUT" 2>/dev/null || true)
  case "$FAILED" in ''|*[!0-9]*) FAILED=0 ;; esac
  if [ "$SHORTFALL" -ne 0 ]; then
    echo "bin/run-bats: only $REPORTED/$EXPECTED tests reported" >&2
    exit 2
  fi
  # bats emits results past its own plan for a setup_file or teardown_file
  # failure. This is the path CI calls, so leaving the check to the merge gave
  # one input two verdicts depending on how the wrapper was invoked.
  if [ "$REPORTED" -gt "$EXPECTED" ]; then
    echo "bin/run-bats: plan says $EXPECTED but $REPORTED results were emitted" >&2
    exit 2
  fi
  [ "$FAILED" -gt 0 ] && exit 1
  exit 0
fi

# --- several files: a slot pool, then one merged plan -------------------
JOBS="${RUN_BATS_JOBS:-}"
if [ -z "$JOBS" ]; then
  JOBS=$( (command -v nproc >/dev/null 2>&1 && nproc) || sysctl -n hw.ncpu 2>/dev/null || echo 4 )
fi
case "$JOBS" in
  ''|*[!0-9]*)
    if [ -n "${RUN_BATS_JOBS:-}" ]; then
      echo "bin/run-bats: RUN_BATS_JOBS must be a positive integer, got '$RUN_BATS_JOBS'" >&2
      exit 2
    fi
    JOBS=4
    ;;
esac
# Re-checked numerically: `00` is all digits and not the string `0`, and a
# zero-width pool never starts a worker and never terminates.
if [ "$JOBS" -lt 1 ]; then
  echo "bin/run-bats: RUN_BATS_JOBS must be a positive integer, got '${RUN_BATS_JOBS:-}'" >&2
  exit 2
fi
[ "$JOBS" -gt ${#FILES[@]} ] && JOBS=${#FILES[@]}

PIDS=()
NEXT=0
RUNNING=0
while [ "$NEXT" -lt ${#FILES[@]} ] || [ "$RUNNING" -gt 0 ]; do
  while [ "$RUNNING" -lt "$JOBS" ] && [ "$NEXT" -lt ${#FILES[@]} ]; do
    # --allow-empty-suite because a filter that matches nothing in ONE file is
    # ordinary once several files run: without it bats errors, emits no clean
    # plan, and the file reads as lost results rather than as zero tests.
    run_bats_once "$WORK/$NEXT.tap" --allow-empty-suite \
      ${FLAGS[@]+"${FLAGS[@]}"} "${FILES[$NEXT]}" &
    PIDS[$NEXT]=$!
    NEXT=$((NEXT + 1))
    RUNNING=$((RUNNING + 1))
  done

  RUNNING=0
  i=0
  while [ "$i" -lt "$NEXT" ]; do
    if [ -n "${PIDS[$i]:-}" ] && kill -0 "${PIDS[$i]}" 2>/dev/null; then
      RUNNING=$((RUNNING + 1))
    fi
    i=$((i + 1))
  done

  [ "$RUNNING" -gt 0 ] && sleep 0.2
done
wait 2>/dev/null

# Merge. Each file's numbering restarts at 1, so the plan the caller sees is
# one sequence across every file — the same shape a serial run emits.
TOTAL=0
PLAN_FOUND=0
i=0
while [ "$i" -lt ${#FILES[@]} ]; do
  PLAN=$(grep -a -m1 -E '^1\.\.[0-9]+' "$WORK/$i.tap" 2>/dev/null || true)
  if [ -n "$PLAN" ]; then
    PLAN_FOUND=1
    TOTAL=$((TOTAL + ${PLAN#1..}))
  fi
  i=$((i + 1))
done

# A run where every file legitimately contributed zero tests -- a filter that
# matched nothing anywhere -- is `1..0` and a success. Only a run where no file
# emitted a plan at all is a failure to report, and then the raw output is the
# only clue to why, so it is dumped.
if [ "$PLAN_FOUND" -eq 1 ] && [ "$TOTAL" -eq 0 ]; then
  # Every file was allowed to contribute nothing, so nothing ran. Silent
  # success here is the report a mistyped filter used to get.
  if [ "$FILTERED" -eq 1 ]; then
    echo "bin/run-bats: no test matched the filter in any of ${#FILES[@]} files" >&2
  else
    echo "bin/run-bats: ${#FILES[@]} files contributed zero tests" >&2
  fi
  exit 2
fi

if [ "$PLAN_FOUND" -eq 0 ]; then
  i=0
  while [ "$i" -lt ${#FILES[@]} ]; do
    cat "$WORK/$i.tap" 2>/dev/null
    i=$((i + 1))
  done
  echo "bin/run-bats: no plan line emitted by bats" >&2
  exit 2
fi

MERGED="$WORK/merged.tap"
: > "$MERGED"
OFFSET=0
FAILED=0
REPORTED=0
SHORT=""
i=0
while [ "$i" -lt ${#FILES[@]} ]; do
  TAP="$WORK/$i.tap"
  LC_ALL=C awk -v base="$OFFSET" '
    /^1\.\.[0-9]+$/ { next }
    /^ok [0-9]+/ {
      n++
      sub(/^ok [0-9]+/, "ok " (n + base))
      print; next
    }
    /^not ok [0-9]+/ {
      n++
      sub(/^not ok [0-9]+/, "not ok " (n + base))
      print; next
    }
    { print }
  ' "$TAP" >> "$MERGED"

  PLAN=$(grep -a -m1 -E '^1\.\.[0-9]+' "$TAP" 2>/dev/null || true)
  COUNT=$(grep -acE '^(ok|not ok) ' "$TAP" 2>/dev/null || true)
  case "$COUNT" in ''|*[!0-9]*) COUNT=0 ;; esac
  BAD=$(grep -acE '^not ok ' "$TAP" 2>/dev/null || true)
  case "$BAD" in ''|*[!0-9]*) BAD=0 ;; esac
  FAILED=$((FAILED + BAD))
  REPORTED=$((REPORTED + COUNT))
  OFFSET=$((OFFSET + COUNT))

  if [ -z "$PLAN" ]; then
    SHORT="$SHORT
  ${FILES[$i]}: no plan line"
  elif [ "$COUNT" -lt "${PLAN#1..}" ]; then
    SHORT="$SHORT
  ${FILES[$i]}: only $COUNT/${PLAN#1..} tests reported"
  fi
  i=$((i + 1))
done

# Everything above counted the per-file TAP files, not the merged stream, so a
# renumbering bug that dropped lines would leave every check happy while the
# caller saw fewer tests than ran. Count what is actually about to be printed,
# and check the numbering is contiguous: a gap or a duplicate means two files'
# results collided and one silently replaced the other.
EMITTED=$(grep -acE '^(ok|not ok) ' "$MERGED" 2>/dev/null || true)
case "$EMITTED" in ''|*[!0-9]*) EMITTED=0 ;; esac
MERGE_FAULT=""
[ "$EMITTED" -eq "$REPORTED" ] \
  || MERGE_FAULT="merged $EMITTED results from $REPORTED reported"
[ -n "$MERGE_FAULT" ] || [ "$EMITTED" -le "$TOTAL" ] \
  || MERGE_FAULT="plan says $TOTAL but $EMITTED results were emitted"
if [ -z "$MERGE_FAULT" ] && [ "$EMITTED" -gt 0 ]; then
  # The number is field 2 on `ok N` and field 3 on `not ok N`; reading field 2
  # for both makes every failing test look like a numbering fault.
  grep -aE '^(ok|not ok) ' "$MERGED" \
    | awk '{ if ($1 == "not") print $3; else print $2 }' \
    | awk 'NR != $1 { exit 1 }' \
    || MERGE_FAULT="merged results are not numbered 1..$EMITTED"
fi

echo "1..$TOTAL"
cat "$MERGED"

# Missing results are worse news than failing tests, so they are reported
# first and they decide the exit code. Checking failures first meant a run that
# lost results AND had a failure exited 1 with nothing on stderr -- measured at
# 577 of 637 results under load, silently.
INCOMPLETE=0
if [ -n "$MERGE_FAULT" ]; then
  echo "bin/run-bats: $MERGE_FAULT — the merge lost or collided results, so this run proves nothing" >&2
  INCOMPLETE=1
fi
if [ -n "$SHORT" ]; then
  echo "bin/run-bats: results are missing, so this run proves nothing:$SHORT" >&2
  INCOMPLETE=1
fi
[ "$INCOMPLETE" -eq 0 ] || exit 2
[ "$FAILED" -gt 0 ] && exit 1
exit 0
