{
  "description": "review-cycle: refuses a commit unless a reviewer saw exactly what it records and the user asked for it; refuses a push the user did not ask for.",
  "modules": ["./register.ts"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/posttool-slop.sh",
            "timeout": 10,
            "statusMessage": "review-cycle: scanning for comment slop"
          }
        ]
      }
    ]
  }
}
