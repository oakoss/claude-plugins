#!/usr/bin/env bash
# review-sentinel: state for the review-cycle gate.
#
# Subcommands:
#   seed         Write current state. Always overwrites. Used by SessionStart.
#   mark         Write current state. Always overwrites. Used by /review
#                Phase 8. Refuses with exit 3 unless a cycle-start marker
#                exists, so the verb cannot be used to clear the gate on
#                work no review looked at.
#   accept-state Write current state, unguarded. The named escape hatch for
#                a human who reviewed the changes themselves; used by
#                /accept, and the only verb the commit gate's chained
#                pass-through accepts.
#   check        Exit 0 if clean tree OR sentinel matches; 1 if drifted; 2 on
#                error (no git repo, no sha tool). Hooks should fail-open on 2.
#   match        Exit 0 only if sentinel exists AND its hash equals current
#                hash computed from its anchor. No clean-tree fast-path.
#                Used by session-init to decide on idempotent re-seed.
#   current-hash Print current hash computed from current HEAD (or the
#                empty tree for unborn HEAD) to stdout.
#   delta        Print the unreviewed delta against the marked tree: a
#                name-status list, `--`, then one `delta: N files, +A -D`
#                summary line. Exit 3 when the sentinel has no usable tree
#                (pre-0.16 mark, or the object was pruned); exit 4 when the
#                index stages content in neither the worktree nor HEAD,
#                which the worktree delta cannot represent — callers scope
#                to the full diff on either. Untracked files included;
#                unaffected by commits moving HEAD.
#   cycle-start  Write .claude/review-cycle/in-progress (epoch seconds). While
#                fresh (< 60 min), the Stop gate lets turns end so the
#                review cycle can await background reviewers. Also the
#                precondition `mark` checks for. Retired by mark (cycle done),
#                accept-state (superseded), and cycle-end (abort); the Stop
#                gate and SessionStart remove stale copies. `seed` leaves it
#                alone — a sibling session's live cycle may own it.
#   cycle-end    Remove the in-progress marker (abort path; a completed
#                cycle's mark clears it anyway).
#   pr-cycle-start / pr-cycle-end
#                The same pair against .claude/review-cycle/pr-in-progress, for
#                /review-pr. It reviews a PR head in a throwaway worktree and
#                never inspects the working tree, so its marker holds the Stop
#                gate open without licensing `mark` over local changes no
#                review looked at.
#   status       Human-readable diagnostic: root, clean-tree verdict, stored
#                mark, current hash from the stored anchor, and a one-line
#                verdict mirroring check's decision. Exit codes match check.
#   paths        Print sentinel and marker paths (relative to project root,
#                one per line) for use in .gitignore.
#   install-hook Install commit-time enforcement as a git pre-commit hook.
#                Only agent sessions are gated (CLAUDECODE env guard); the
#                kill-switch and per-project opt-outs are honored; humans
#                and repos without this binary fail open. Manager-aware:
#                lefthook repos get a helper script plus a lefthook job
#                (direct .git/hooks writes get clobbered by `lefthook
#                install`); pre-commit and simple-git-hooks repos get the
#                helper plus a printed snippet (their committed config is
#                not auto-edited); husky and other core.hooksPath setups
#                are handled implicitly because the hooks dir is resolved
#                via `git rev-parse --git-path hooks`; plain git gets a
#                marker-managed hook, with any pre-existing hook relocated
#                to pre-commit.local and chained first, status preserved.
#   uninstall-hook  Remove the gate: restore a relocated .local hook and
#                delete the helper script.
#
# Format on disk: two or three lines.
#   anchor:<40-hex-sha>     ← HEAD SHA at mark time, or the empty-tree SHA
#                             (4b825dc6…) when HEAD is unborn
#   sha256:<64-hex-chars>   ← hash of the anchor→index and index→working-tree
#                             diffs (untracked files normalized via a scratch
#                             intent-to-add index; see compute_hash_from_anchor)
#   tree:<40-hex-sha>       ← optional: git tree of the reviewed working-tree
#                             content, kept alive by a per-worktree ref under
#                             refs/review-cycle/trees/. check/match compare
#                             against it (content equality — immune to
#                             commit-split hunk drift, near-constant cost);
#                             a divergent index routes to the hash, which
#                             arbitrates index states the tree cannot see.
#                             Absent or unreadable, the gate falls back to
#                             the hash path. Capturing the comparison tree writes
#                             unreferenced blobs into the object database on
#                             every check — bounded by content the user
#                             wrote; gc removes them on expiry.
# Path: <project-root>/.claude/review-cycle/mark  (pre-0.16: .claude/.review-mark,
# moved by session-init's one-time migration)
#
# Why anchor + diff-hash instead of one hash: each `git commit` advances HEAD
# and shrinks `git diff HEAD`, so a HEAD-relative sentinel drifts the moment
# any reviewed work is committed. Anchoring at the commit that was HEAD at
# mark time means subsequent commits of already-reviewed content leave the
# anchor→working-tree diff unchanged, so a single review covers an arbitrary
# number of follow-up commits.
#
# Project root resolution (in order):
#   1. --root <path> flag (explicit)
#   2. CLAUDE_PROJECT_DIR env var (set by Claude Code)
#   3. git rev-parse --show-toplevel from current cwd

set -uo pipefail

EMPTY_TREE_SHA="4b825dc642cb6eb9a060e54bf8d69288fbee4904"

usage() {
  cat >&2 <<EOF
usage: review-sentinel [--root <path>] <subcommand>

subcommands:
  seed          write current state (used by SessionStart)
  mark          write current state; requires cycle-start (used by /review)
  accept-state  write current state, unguarded (used by /accept)
  check         exit 0=clean/match, 1=drift, 2=error
  match         exit 0=exact match only (no clean-tree shortcut)
  current-hash  print current state
  delta         print the unreviewed delta vs the marked tree (exit 3 = none stored)
  cycle-start   write the review-in-progress marker (Stop gate passes)
  cycle-end     remove the review-in-progress marker
  pr-cycle-start  same, for /review-pr; does not license mark
  pr-cycle-end    remove the review-pr marker
  status        diagnostic dump; exit codes mirror check
  paths         print gitignore-relative paths
  install-hook  install commit-time git pre-commit enforcement
  uninstall-hook  remove the gate, restoring any relocated hook
EOF
  exit 2
}

pick_sha() {
  if command -v sha256sum >/dev/null 2>&1; then
    echo "sha256sum"
  elif command -v shasum >/dev/null 2>&1; then
    echo "shasum -a 256"
  else
    return 1
  fi
}

# Path to the per-project config file. Intentionally NOT included in the
# default excludes; see SECURITY note below.
CONFIG_PATH=".claude/review-cycle.json"

# Machine-written state only; user-facing paths (.no-review-gate, the config
# — a sibling file the state glob cannot match — and the helper) stay put.
STATE_DIR=".claude/review-cycle"
SENTINEL_REL="$STATE_DIR/mark"

# A shared-namespace ref with a per-worktree NAME keeps each marked tree
# gc-reachable: linked worktrees share custom refs, so one name would let
# worktree B's mark orphan worktree A's tree — and refs/worktree/ fails the
# other way (measured on git 2.55.0: gc from one worktree prunes another's).
marked_tree_ref() {
  local gd wtid sha digest
  gd=$(git -C "$1" rev-parse --git-dir 2>/dev/null) || return 1
  case "$gd" in
    */worktrees/*)
      # The wt- prefix reserves the bare name for the primary (a linked
      # worktree named main must not collide with it), and the git-dir
      # digest separates linked worktrees whose names normalize alike.
      wtid=$(printf 'wt-%s' "${gd##*/}" | tr -c 'A-Za-z0-9_-' '-')
      if sha=$(pick_sha); then
        digest=$(printf '%s' "$gd" | $sha 2>/dev/null | cut -c1-12)
        [ -n "$digest" ] && wtid="$wtid-$digest"
      fi
      ;;
    *) wtid="main" ;;
  esac
  printf 'refs/review-cycle/trees/%s\n' "$wtid"
}

# Declared here so `set -u` doesn't error before the first build_excludes call.
EXCLUDES_LIST=()

# SECURITY: the config file itself is intentionally NOT in the default
# excludes. compute_hash_from_anchor and is_clean_tree force-include
# CONFIG_PATH in their inputs, so user `ignore` patterns matching the config
# (`**`, `.claude/**`, etc.) cannot hide config edits from the hash. Editing
# the config always forces a review pass before its rules take effect.
build_excludes() {
  local root="$1" pattern
  # Excluded at any depth: a monorepo subpackage's `.beads/` would otherwise
  # read as code drift and gate the commit. The bare-root form is kept because
  # older git pathspec parsers treat a leading `**/` as one-or-more dirs, not
  # zero-or-more.
  EXCLUDES_LIST=(
    ':(exclude,glob).claude/review-cycle/**'
    ':(exclude).claude/.no-review-gate'
    # Pre-0.16.0 state paths. A repo that has not run the SessionStart
    # migration (or runs with hooks disabled) still carries them, and where
    # init never gitignored them they would read as drift.
    ':(exclude).claude/.review-mark'
    ':(exclude).claude/.review-in-progress'
    ':(exclude).claude/.review-pr-in-progress'
    ':(exclude).claude/.review-stop-block'
    ':(exclude,glob).beads/**'
    ':(exclude,glob)**/.beads/**'
    ':(exclude,glob).trekker/**'
    ':(exclude,glob)**/.trekker/**'
    ':(exclude,glob).vscode/**'
    ':(exclude,glob)**/.vscode/**'
    ':(exclude,glob).idea/**'
    ':(exclude,glob)**/.idea/**'
    ':(exclude,glob).zed/**'
    ':(exclude,glob)**/.zed/**'
    ':(exclude,glob).cursor/**'
    ':(exclude,glob)**/.cursor/**'
    ':(exclude,glob).fleet/**'
    ':(exclude,glob)**/.fleet/**'
  )
  local config_file="$root/$CONFIG_PATH"
  [ -f "$config_file" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  while IFS= read -r pattern; do
    [ -z "$pattern" ] && continue
    EXCLUDES_LIST+=(":(exclude,glob)$pattern")
  done < <(jq -r '(.ignore // []) | .[]? | select(type == "string")' "$config_file" 2>/dev/null)
}

# Which in-progress marker a cycle verb operates on. `review-pr` reviews a PR
# head in a throwaway worktree and deliberately never inspects the working
# tree, so its marker must not be the one `mark` accepts as evidence —
# otherwise reviewing someone else's PR licenses marking your own unreviewed
# work. Both markers hold the Stop gate open; only this one licenses `mark`.
marker_for() {
  case "$1" in
    pr-*) echo "pr-in-progress" ;;
    *) echo "in-progress" ;;
  esac
}

resolve_project_root() {
  local candidate
  for candidate in "$ROOT_OVERRIDE" "${CLAUDE_PROJECT_DIR:-}"; do
    [ -n "$candidate" ] || continue
    [ -d "$candidate" ] || continue
    git -C "$candidate" rev-parse --show-toplevel 2>/dev/null && return 0
  done
  git rev-parse --show-toplevel 2>/dev/null
}

# Resolve current anchor: HEAD SHA if present, empty-tree SHA otherwise.
current_anchor() {
  local root="$1" sha
  sha=$(git -C "$root" rev-parse HEAD 2>/dev/null) && {
    echo "$sha"
    return 0
  }
  echo "$EMPTY_TREE_SHA"
}

# Populate the throwaway index at $2 from $1's real index, then intent-to-add
# the untracked files so the index→working-tree diff renders each as a
# new-file patch byte-identical to its staged form (which is what lets an
# untracked, staged, and committed new file all hash the same). Uses the
# global EXCLUDES_LIST and CONFIG_PATH. Returns nonzero if any cp/git step
# fails; the caller must treat that as drift, never a clean hash. $2 must not
# already exist as a non-empty file — git rejects a 0-byte index as corrupt.
# Runs `cd "$root"`, so callers invoke it in a subshell to contain that.
build_scratch_index() {
  local root="$1" scratch="$2" realidx others
  cd "$root" || return 1
  realidx=$(git rev-parse --git-path index) || return 1
  if [ -f "$realidx" ]; then cp "$realidx" "$scratch" || return 1; fi
  # Only intent-add when there are untracked files: GNU xargs (unlike BSD)
  # runs the command once even on empty input, so an unguarded pipe would
  # invoke `git add -N --` with no paths and fail on a clean or tracked-only
  # tree. The guard skips xargs entirely in that common case. `xargs -0`
  # propagates a `git add` failure (e.g. a path that vanished mid-run).
  others=$(git ls-files --others --exclude-standard -- "${EXCLUDES_LIST[@]}") || return 1
  if [ -n "$others" ]; then
    git ls-files --others --exclude-standard -z -- "${EXCLUDES_LIST[@]}" \
      | GIT_INDEX_FILE="$scratch" xargs -0 git add -N -- 2>/dev/null || return 1
  fi
  # Force-include the config even when gitignored (common when the project
  # gitignores all of .claude/), so its untracked bytes always reach the hash.
  # -f overrides the ignore; -N keeps it an intent-to-add like the others so
  # staged and untracked config hash the same way.
  if [ -f "$CONFIG_PATH" ] \
     && ! git ls-files --error-unmatch -- "$CONFIG_PATH" >/dev/null 2>&1; then
    GIT_INDEX_FILE="$scratch" git add -Nf -- "$CONFIG_PATH" 2>/dev/null || return 1
  fi
  [ -f "$scratch" ] || GIT_INDEX_FILE="$scratch" git read-tree --empty || return 1
}

# Write a tree object of the working tree's content. Stages for real, not
# intent-to-add: write-tree silently omits ita entries (measured on git
# 2.55.0 — no error, the file is absent from the tree). Blobs land in the
# object database; the real index is never touched. Excluded paths are
# removed from the tree outright — a .beads write between mark and check
# must not drift it — and the config is force-added back per the SECURITY
# note. Prints the tree id. cd's into $root; callers run it in a subshell.
build_worktree_tree() {
  local root="$1" scratch="$2" realidx p positives=()
  cd "$root" || return 1
  build_excludes "$root"
  realidx=$(git rev-parse --git-path index) || return 1
  if [ -f "$realidx" ]; then cp "$realidx" "$scratch" || return 1; fi
  [ -f "$scratch" ] || GIT_INDEX_FILE="$scratch" git read-tree --empty || return 1
  # git add refuses (exit 1, "paths are ignored by one of your .gitignore
  # files") whenever an exclude pathspec names an existing gitignored path —
  # a directory, a file, even an empty directory — and init gitignores both
  # the state dir and the opt-out marker, so every init'd repo hit it. Drop
  # only the pattern-ignored excludes from the add: git skips those
  # paths anyway, so the tree is unchanged, while the excludes that remain
  # keep the add out of directories it must not walk (an unreadable file
  # there aborts the add at exit 128, and staging a large excluded tree
  # costs seconds plus garbage blobs). The rm sweep still drops every
  # excluded path from the tree either way. --no-index: tracked content in
  # an ignored dir suppresses plain check-ignore while add still refuses.
  local bares=() bare ignored="" add_ex=() i=0
  for p in "${EXCLUDES_LIST[@]}"; do
    case "$p" in
      ':(exclude,glob)'*) bare="${p#':(exclude,glob)'}" ;;
      ':(exclude)'*)      bare="${p#':(exclude)'}" ;;
      *)                  bare="$p" ;;
    esac
    bare="${bare%%/\*\**}"
    bare="${bare%/}"
    bares+=("$bare")
  done
  if [ "${#bares[@]}" -gt 0 ]; then
    ignored=$(printf '%s\n' "${bares[@]}" | git check-ignore --no-index --stdin 2>/dev/null)
  fi
  for p in "${EXCLUDES_LIST[@]}"; do
    case $'\n'"$ignored"$'\n' in
      *$'\n'"${bares[$i]}"$'\n'*) : ;;
      *) add_ex+=("$p") ;;
    esac
    i=$((i+1))
  done
  # bash 3.2 errors on empty-array expansion under set -u; an allowlist
  # .gitignore (/* with negations) empties add_ex.
  if [ "${#add_ex[@]}" -gt 0 ]; then
    GIT_INDEX_FILE="$scratch" git add -A -- . "${add_ex[@]}" 2>/dev/null || return 1
  else
    GIT_INDEX_FILE="$scratch" git add -A -- . 2>/dev/null || return 1
  fi
  for p in "${EXCLUDES_LIST[@]}"; do
    case "$p" in
      ':(exclude,glob)'*) positives+=(":(glob)${p#':(exclude,glob)'}") ;;
      ':(exclude)'*)      positives+=("${p#':(exclude)'}") ;;
    esac
  done
  if [ "${#positives[@]}" -gt 0 ]; then
    # -f is load-bearing: without it, a path excluded from the add whose
    # index content matches neither HEAD nor the worktree makes git rm
    # --cached refuse, and every capture fails until that entry clears.
    GIT_INDEX_FILE="$scratch" git rm -r -q -f --cached --ignore-unmatch -- "${positives[@]}" >/dev/null 2>&1 || return 1
  fi
  if [ -f "$CONFIG_PATH" ]; then
    GIT_INDEX_FILE="$scratch" git add -f -- "$CONFIG_PATH" 2>/dev/null || return 1
  fi
  GIT_INDEX_FILE="$scratch" git write-tree 2>/dev/null
}

capture_worktree_tree() {
  local root="$1" scratch tree rc=0
  scratch=$(mktemp) || return 1
  /bin/rm -f "$scratch"
  tree=$( (build_worktree_tree "$root" "$scratch") ) || rc=1
  /bin/rm -f "$scratch" 2>/dev/null
  [ "$rc" -eq 0 ] || return 1
  [[ "$tree" =~ ^[a-f0-9]{40}$ ]] || return 1
  printf '%s\n' "$tree"
}

# Router, not verdict: a path whose index entry differs from BOTH the
# worktree and HEAD means the index holds content the tree cannot vouch for
# — staged unreviewed X with a restored worktree (the Codex P1 shape), but
# equally a partial stage of reviewed content. Only the hash can tell those
# apart, so callers route exit 1 to the hash path rather than reporting
# drift. A false positive costs precision, not safety: a partial stage of
# reviewed content made AFTER the mark falls to the hash, which cannot
# represent the split and reports drift — one accept-state clears it. The
# config is force-included as the hash does (an ignore matching it must not
# skip the routing), and --no-renames keeps both lists on raw paths — a
# staged rename otherwise pairs into names whose intersection can miss.
# Exit 2 = probe error; callers must never read it as no-divergence.
staged_divergence() {
  local root="$1" base unstaged staged
  cd "$root" || return 2
  build_excludes "$root"
  base=$(current_anchor "$root") || return 2
  unstaged=$( { git diff --no-renames --name-only -- "${EXCLUDES_LIST[@]}" \
                && git diff --no-renames --name-only -- "$CONFIG_PATH"; } 2>/dev/null) || return 2
  [ -n "$unstaged" ] || return 0
  staged=$( { git diff --no-renames --cached --name-only "$base" -- "${EXCLUDES_LIST[@]}" \
              && git diff --no-renames --cached --name-only "$base" -- "$CONFIG_PATH"; } 2>/dev/null) || return 2
  [ -n "$staged" ] || return 0
  # No pipeline feeds the intersection: a dying producer — a sort, or the
  # printf inside a process substitution — collapses into grep's benign
  # exit 1 and reads as no-divergence (measured: a SIGKILLed producer made
  # check pass on staged unreviewed content). Checked temp files leave the
  # case with grep's own status alone, where any abnormal exit maps to 2.
  local usf ssf rc
  usf=$(mktemp) || return 2
  ssf=$(mktemp) || { /bin/rm -f "$usf"; return 2; }
  if ! printf '%s\n' "$unstaged" | sort -u > "$usf" 2>/dev/null \
     || ! printf '%s\n' "$staged" | sort -u > "$ssf" 2>/dev/null; then
    /bin/rm -f "$usf" "$ssf"
    return 2
  fi
  grep -qFx -f "$ssf" "$usf"
  rc=$?
  /bin/rm -f "$usf" "$ssf"
  case $rc in
    0) return 1 ;;
    1) return 0 ;;
    *) return 2 ;;
  esac
}

# Compute the sha256 of the diff from anchor to the current effective state
# (anchor→index AND index→working-tree, per path, sorted by path). Returns 0
# with hash on stdout; 1 on unrecoverable error (no work tree, no sha tool,
# pipeline failure); 2 if the anchor is not reachable as a commit or tree in
# the object database, or if any git invocation in the hash stream fails.
#
# Why a git failure is drift rather than an error: a failed diff cannot be
# distinguished from "nothing differs" by its output. Left unchecked, a failure
# hashes to sha256("") — the exact value a mark taken on a clean tree stores —
# and the gate reports "match" on an unreviewed tree. Every git call therefore
# signals with exit 9, which maps to 2 (block).
#
# The stream is generated into a file and hashed separately rather than piped
# straight into the sha tool: pipefail reports the RIGHTMOST nonzero status, so
# in one pipeline a concurrent sha or cut failure masks the 9, and the git
# failure degrades to an ordinary tool error that hooks fail open on.
#
# Per-path iteration with sorted ordering is what makes the hash invariant
# under four different transformations of the same content:
#
#   1. Committing reviewed content. After commit, --cached <anchor> covers
#      the committed delta and `git diff` covers what remains uncommitted.
#      The combined per-path bytes match the pre-commit state where the same
#      content was all in `git diff`.
#   2. Staging or unstaging reviewed content (no content change). With
#      --no-prefix the cached and uncached diff streams produce byte-identical
#      output for the same content delta, so moving content between staged
#      and unstaged does not drift the hash.
#   3. Staging a reviewed *new* file. An untracked file would otherwise hash
#      via a different representation than its staged form, so `git add`-ing
#      it between mark and commit read as drift. To normalize, untracked files
#      are intent-to-added (`git add -N`) into a throwaway copy of the index
#      and the index→working-tree segment is diffed against that scratch
#      index. Intent-to-add makes `git diff` emit a new file exactly as
#      `git diff --cached` emits a staged add, so untracked, staged, and
#      committed forms of the same new file all hash identically. The real
#      index and working tree are never mutated.
#   4. Codex P1 bypass — staging unreviewed content and then restoring the
#      working tree to the reviewed state. The --cached diff (against the real
#      index) captures the unreviewed index content, so the hash changes and
#      the gate fires. The scratch index covers only the worktree segment, so
#      it cannot mask an index/worktree divergence.
#
# A naïve `--cached anchor` ++ `diff` concatenation breaks property 1: the
# alphabetical ordering shifts across stream boundaries (e.g. {bar, foo}
# alphabetical in one stream pre-commit, then {foo cached, bar unstaged}
# split across two streams post-commit). Sorting paths and emitting both
# streams per path keeps the output order stable regardless of which stream
# a particular file's diff lives in.
compute_hash_from_anchor() {
  local root="$1" anchor="$2" sha h kind paths scratch stream errlog detail gitmsg rc=0
  git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "review-sentinel: not inside a git work tree" >&2
    return 1
  }
  sha=$(pick_sha) || {
    echo "review-sentinel: no sha256 tool (sha256sum/shasum missing?)" >&2
    return 1
  }
  kind=$(git -C "$root" cat-file -t "$anchor" 2>/dev/null) || return 2
  case "$kind" in
    commit|tree) ;;
    *) return 2 ;;
  esac

  build_excludes "$root"

  # Smoke-test the assembled pathspec. If git rejects it (malformed user
  # pattern, corrupted index, missing object), return 2; check maps that
  # to drift, so hooks block. Returning 1 here would map to check exit 2
  # which hooks fail-open on, re-opening the bypass.
  git -C "$root" status --porcelain -- "${EXCLUDES_LIST[@]}" >/dev/null 2>&1 || return 2

  # mktemp leaves an empty file, which git rejects as a corrupt index, so it
  # is removed first; build_scratch_index recreates it. The build runs in a
  # subshell to contain its `cd`, and its failure is coupled to return 2
  # (drift → block): a `git diff` against a *missing* GIT_INDEX_FILE silently
  # reports an empty index and exits 0, so a partial scratch would drop the
  # entire worktree segment from the hash and yield a stale-looking-but-
  # passing hash. A build failure must never read as a clean hash.
  scratch=$(mktemp) || return 1
  /bin/rm -f "$scratch"
  if ! ( build_scratch_index "$root" "$scratch" ); then
    /bin/rm -f "$scratch"
    return 2
  fi

  stream=$(mktemp) || { /bin/rm -f "$scratch"; return 1; }
  errlog=$(mktemp) || { /bin/rm -f "$scratch" "$stream"; return 1; }
  # Each failure names what it was doing before exiting, so the block can point
  # at a file rather than an anchor SHA. git's own message lands here too.
  ( cd "$root" || { echo "entering the project root" >&2; exit 9; }
    paths=$({
              git diff --cached --name-only "$anchor" -- "${EXCLUDES_LIST[@]}" \
                || { echo "listing staged changes" >&2; exit 9; }
              GIT_INDEX_FILE="$scratch" git diff --name-only -- "${EXCLUDES_LIST[@]}" \
                || { echo "listing working-tree changes" >&2; exit 9; }
              # Force-include the config file: user `ignore` patterns
              # must not hide config edits from the hash.
              git diff --cached --name-only "$anchor" -- "$CONFIG_PATH" \
                || { echo "listing staged changes to $CONFIG_PATH" >&2; exit 9; }
              GIT_INDEX_FILE="$scratch" git diff --name-only -- "$CONFIG_PATH" \
                || { echo "listing working-tree changes to $CONFIG_PATH" >&2; exit 9; }
            } | LC_ALL=C sort -u) || exit 9
    if [ -n "$paths" ]; then
      while IFS= read -r p; do
        git diff --cached --binary --no-prefix "$anchor" -- "$p" \
          || { echo "diffing $p (staged)" >&2; exit 9; }
        GIT_INDEX_FILE="$scratch" git diff --binary --no-prefix -- "$p" \
          || { echo "diffing $p (working tree)" >&2; exit 9; }
      done <<< "$paths"
    fi
  ) >"$stream" 2>"$errlog"
  rc=$?
  /bin/rm -f "$scratch"
  if [ "$rc" -eq 9 ]; then
    # The marker is written after git's own message, so it lands last. Both
    # matter — the marker says which operation, git says why it failed.
    detail=$(grep -v '^[[:space:]]*$' "$errlog" 2>/dev/null | tail -1)
    gitmsg=$(grep -v '^[[:space:]]*$' "$errlog" 2>/dev/null | tail -2 | head -1)
    [ "$gitmsg" = "$detail" ] && gitmsg=""
    echo "review-sentinel: git failed while ${detail:-diffing}${gitmsg:+ — $gitmsg} (anchor $anchor); treating as drift" >&2
    /bin/rm -f "$stream" "$errlog"
    return 2
  fi
  /bin/rm -f "$errlog"
  if [ "$rc" -ne 0 ]; then
    /bin/rm -f "$stream"
    return 1
  fi
  h=$($sha < "$stream" 2>/dev/null | cut -d' ' -f1)
  rc=$?
  /bin/rm -f "$stream"
  [ $rc -eq 0 ] || return 1
  [ -n "$h" ] || return 1
  echo "sha256:$h"
}

# Mirrors 0.5.1's clean-tree fast-path so post-commit clean states pass
# regardless of the stored sentinel.
is_clean_tree() {
  local root="$1" status config_status
  build_excludes "$root"
  # Force not-clean when the config exists AND is gitignored: `git status`
  # can't see edits to ignored files, so the fast-path would short-circuit
  # past a real bypass. Tracked configs and untracked-not-gitignored
  # configs go through the status check normally, preserving the 0.6.0
  # multi-commit-doesn't-drift property after they're committed.
  if [ -f "$root/$CONFIG_PATH" ] \
     && (cd "$root" && git check-ignore -q "$CONFIG_PATH" 2>/dev/null); then
    return 1
  fi
  if ! status=$(cd "$root" && git status --porcelain --untracked-files=all -- \
                "${EXCLUDES_LIST[@]}" 2>/dev/null); then
    return 1
  fi
  # Independent visibility check for the config path. User `ignore`
  # patterns like `**` or `.claude/**` would otherwise hide config edits
  # from the main status call; we re-check the config path without
  # applying user excludes so those patterns can't fast-path past their
  # own edit.
  if ! config_status=$(cd "$root" && git status --porcelain --untracked-files=all -- \
                       "$CONFIG_PATH" 2>/dev/null); then
    return 1
  fi
  [ -z "$status" ] && [ -z "$config_status" ]
}

# Returns 0 with empty output when the file does not exist; nonzero with a
# stderr warning on malformed content.
read_sentinel() {
  local sentinel="$1" anchor_line hash_line
  [ -f "$sentinel" ] || return 0
  anchor_line=$(sed -n '1p' "$sentinel" 2>/dev/null | tr -d '[:space:]')
  hash_line=$(sed -n '2p' "$sentinel" 2>/dev/null | tr -d '[:space:]')
  if [[ "$anchor_line" =~ ^anchor:[a-f0-9]{40}$ ]] && \
     [[ "$hash_line"   =~ ^sha256:[a-f0-9]{64}$ ]]; then
    printf '%s\n%s\n' "$anchor_line" "$hash_line"
    return 0
  fi
  echo "review-sentinel: malformed sentinel at $sentinel; expected 'anchor:<40-hex>' + 'sha256:<64-hex>' (treating as drift)" >&2
  return 1
}

# Line 3 is read from the file directly: read_sentinel validates and re-emits
# lines 1-2 only, so its return value never carries the tree. A two-line
# (pre-0.16) sentinel returns nonzero — callers fall back to the hash path.
read_sentinel_tree() {
  local sentinel="$1" tree_line
  [ -f "$sentinel" ] || return 1
  tree_line=$(sed -n '3p' "$sentinel" 2>/dev/null | tr -d '[:space:]')
  [[ "$tree_line" =~ ^tree:[a-f0-9]{40}$ ]] || return 1
  printf '%s\n' "${tree_line#tree:}"
}

write_sentinel() {
  local sentinel="$1" content="$2" tmp err
  if ! err=$(mkdir -p "$(dirname "$sentinel")" 2>&1); then
    echo "review-sentinel: $err" >&2
    return 1
  fi
  tmp="${sentinel}.tmp.$$"
  # `command > file` redirects stdout to the file before any capture sees
  # it, so capturing stderr-as-stdout via $(... 2>&1) is impossible here.
  # Check the exit code directly; printf failures (full disk, EROFS) are
  # rare enough that the bare path in the error message suffices.
  if ! printf '%s\n' "$content" > "$tmp" 2>/dev/null; then
    echo "review-sentinel: write to $tmp failed" >&2
    /bin/rm -f "$tmp" 2>/dev/null
    return 1
  fi
  if ! err=$(mv "$tmp" "$sentinel" 2>&1); then
    echo "review-sentinel: rename $tmp -> $sentinel failed: $err" >&2
    /bin/rm -f "$tmp" 2>/dev/null
    return 1
  fi
  return 0
}

HOOK_MARK_BEGIN="# >>> review-cycle gate >>>"
HOOK_MARK_END="# <<< review-cycle gate <<<"

# Emit the pre-commit gate body (POSIX sh). $1 is the absolute path of this
# binary at install time, embedded single-quoted with '\'' escaping so a $
# or " in the path can neither re-expand at hook runtime (silent fail-open)
# nor break the generated script (blocking humans with a bare syntax error).
#
# Behavior of the generated hook:
#   - A pre-existing hook relocated by the installer to <hook>.local runs
#     first with its exit status preserved; the gate only runs after it
#     passed. Under the standalone helper $0.local never exists, so the
#     chain is a no-op there.
#   - The env guard means humans are never gated; the kill-switch and
#     per-project opt-outs are honored next, mirroring hooks/lib/gate.sh
#     precedence (a proper-boolean config `disabled` wins; otherwise the
#     legacy marker decides).
#   - A missing binary (plugin uninstalled, different machine) and check's
#     error exit (rc=2) both fail open.
#   - The check runs in a subshell with git's hook-time env vars cleared:
#     GIT_INDEX_FILE may point at a partial-commit temp index and a
#     relative GIT_DIR would skew hash computation. cwd is the worktree top
#     for pre-commit hooks, so --root . resolves the right repo even when
#     CLAUDE_PROJECT_DIR points elsewhere.
hook_block() {
  local esc_self
  esc_self=$(printf '%s' "$1" | sed "s/'/'\\\\''/g")
  cat <<EOF
$HOOK_MARK_BEGIN
# Installed by 'review-sentinel install-hook' (review-cycle plugin).
# Blocks agent-session commits of unreviewed changes at commit time.
# Do not edit between markers; re-run install-hook to regenerate, or
# run 'review-sentinel uninstall-hook' to remove.
if [ -x "\$0.local" ]; then
  "\$0.local" "\$@"
  rc_local=\$?
  [ "\$rc_local" -ne 0 ] && exit "\$rc_local"
fi
review_cycle_gate() {
  [ -n "\${CLAUDECODE:-}\${CLAUDE_CODE_ENTRYPOINT:-}" ] || return 0
  [ -f "\$HOME/.claude/.disable-review-gate" ] && return 0
  cfg=".claude/review-cycle.json"
  if [ -f "\$cfg" ] && command -v jq >/dev/null 2>&1 \\
     && jq -e '(.disabled | type) == "boolean"' "\$cfg" >/dev/null 2>&1; then
    jq -e '.disabled == true' "\$cfg" >/dev/null 2>&1 && return 0
  elif [ -f .claude/.no-review-gate ]; then
    return 0
  fi
  rs='$esc_self'
  [ -x "\$rs" ] || return 0
  ( unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE; exec "\$rs" --root . check )
  case \$? in
    1)
      echo "review-cycle: unreviewed changes — state differs from the last reviewed mark." >&2
      echo "review-cycle: run /review-cycle:review, or /review-cycle:accept if already reviewed (a commit-time formatter or hook manager may have changed files; re-stage first). Diagnose: \$rs status" >&2
      return 1
      ;;
    *) return 0 ;;
  esac
}
review_cycle_gate || exit 1
$HOOK_MARK_END
EOF
}

# Create or refresh hook file $1 with managed content $2. A pre-existing
# foreign hook is relocated to $1.local and chained by the managed block —
# appending shell text to a foreign hook could swallow its failure status
# (the appended text, not the hook's last fallible command, would decide the
# exit), sit dead behind an explicit `exit 0`, or corrupt a non-shell
# interpreter's script. When the file carries our marker, the managed block
# is stripped first and any
# nontrivial remainder (an append-era install, hand-added lines) is
# relocated the same way rather than truncated.
write_hook_file() {
  local target="$1" block="$2" moved=0 tmp
  if [ -f "$target" ]; then
    if grep -qF "$HOOK_MARK_BEGIN" "$target"; then
      tmp="${target}.tmp.$$"
      awk -v begin="$HOOK_MARK_BEGIN" -v end="$HOOK_MARK_END" '
        $0 == begin {skip=1; next}
        $0 == end {skip=0; next}
        !skip' "$target" > "$tmp" || { /bin/rm -f "$tmp"; return 1; }
      if grep -qEv '^#!/bin/sh$|^#!/usr/bin/env sh$|^[[:space:]]*$' "$tmp"; then
        if [ -e "${target}.local" ]; then
          /bin/rm -f "$tmp"
          echo "review-sentinel: both $target and ${target}.local hold non-managed content; resolve manually before installing" >&2
          return 2
        fi
        mv "$tmp" "${target}.local" || { /bin/rm -f "$tmp"; return 1; }
        chmod +x "${target}.local" 2>/dev/null
        moved=1
        echo "review-sentinel: non-managed hook content moved to ${target}.local; it still runs first"
      else
        /bin/rm -f "$tmp"
      fi
    else
      if [ -e "${target}.local" ]; then
        echo "review-sentinel: both $target and ${target}.local exist; resolve manually before installing" >&2
        return 2
      fi
      mv "$target" "${target}.local" || {
        echo "review-sentinel: cannot relocate $target" >&2
        return 2
      }
      moved=1
      if [ -x "${target}.local" ]; then
        echo "review-sentinel: existing hook moved to ${target}.local; it still runs first and its failures still block"
      else
        echo "review-sentinel: existing hook moved to ${target}.local; it is not executable, so the chain skips it (git ignored it too)" >&2
      fi
    fi
  fi
  # A failed write or chmod must never report success — git skips a
  # non-executable hook, which would also strand a just-relocated foreign
  # hook. Roll the relocation back on failure.
  if ! printf '#!/bin/sh\n%s\n' "$block" > "$target" || ! chmod +x "$target"; then
    echo "review-sentinel: cannot install executable hook at $target" >&2
    /bin/rm -f "$target"
    [ "$moved" -eq 1 ] && mv "${target}.local" "$target"
    return 1
  fi
  return 0
}

uninstall_hook() {
  local root="$1" hooks_dir target removed=0 tmp
  hooks_dir=$(git -C "$root" rev-parse --git-path hooks 2>/dev/null) || {
    echo "review-sentinel: cannot resolve hooks dir" >&2
    return 2
  }
  case "$hooks_dir" in
    /*) ;;
    *) hooks_dir="$root/$hooks_dir" ;;
  esac
  target="$hooks_dir/pre-commit"
  if [ -f "$target" ] && grep -qF "$HOOK_MARK_BEGIN" "$target"; then
    # Mirror write_hook_file: content outside the markers is not ours and
    # must survive the uninstall too.
    tmp="${target}.tmp.$$"
    awk -v begin="$HOOK_MARK_BEGIN" -v end="$HOOK_MARK_END" '
      $0 == begin {skip=1; next}
      $0 == end {skip=0; next}
      !skip' "$target" > "$tmp" || {
      /bin/rm -f "$tmp"
      echo "review-sentinel: cannot update $target (hooks dir not writable?)" >&2
      return 2
    }
    if grep -qEv '^#!/bin/sh$|^#!/usr/bin/env sh$|^[[:space:]]*$' "$tmp"; then
      mv "$tmp" "$target" || {
        /bin/rm -f "$tmp"
        echo "review-sentinel: cannot rewrite $target" >&2
        return 2
      }
      chmod +x "$target" 2>/dev/null
      echo "review-sentinel: gate removed from $target; non-managed hook content kept"
      if [ -e "${target}.local" ]; then
        echo "review-sentinel: ${target}.local also exists and is NOT running; merge or restore it manually" >&2
      fi
    elif [ -f "${target}.local" ]; then
      /bin/rm -f "$tmp"
      mv "${target}.local" "$target" || {
        echo "review-sentinel: cannot restore ${target}.local" >&2
        return 2
      }
      echo "review-sentinel: gate removed; original hook restored at $target"
    else
      /bin/rm -f "$tmp"
      /bin/rm -f "$target" || {
        echo "review-sentinel: cannot remove $target" >&2
        return 2
      }
      echo "review-sentinel: gate removed from $target"
    fi
    removed=1
  elif [ -e "${target}.local" ]; then
    echo "review-sentinel: $target is not managed by review-cycle but ${target}.local exists — a hook relocated by install-hook is currently NOT running; restore it with: mv ${target}.local $target" >&2
  fi
  if [ -f "$root/$HELPER_REL" ]; then
    /bin/rm -f "$root/$HELPER_REL" || {
      echo "review-sentinel: cannot remove $root/$HELPER_REL" >&2
      return 2
    }
    echo "review-sentinel: helper removed ($HELPER_REL); any lefthook/pre-commit job referencing it is guarded and now a no-op — remove the config entry at leisure"
    removed=1
  fi
  [ $removed -eq 0 ] && echo "review-sentinel: nothing to uninstall"
  return 0
}

# The committed-config managers get a helper script plus a snippet; the
# helper is the same gate body, so the snippet's entry works verbatim.
HELPER_REL=".claude/review-cycle-pre-commit.sh"

write_helper() {
  local root="$1" self="$2"
  mkdir -p "$root/.claude" || return 1
  printf '#!/bin/sh\n%s\n' "$(hook_block "$self")" > "$root/$HELPER_REL" || return 1
  chmod +x "$root/$HELPER_REL" 2>/dev/null
  return 0
}

install_hook() {
  local root="$1" self="$2" f config hooks_dir target
  # Lefthook first: `lefthook install` clobbers .git/hooks, so enforcement
  # must ride its config. The job's run is guarded so teammates without
  # the helper (e.g. .claude/ gitignored) are never broken.
  config=""
  for f in lefthook.yml lefthook.yaml .lefthook.yml .lefthook.yaml; do
    [ -f "$root/$f" ] && { config="$root/$f"; break; }
  done
  if [ -n "$config" ]; then
    write_helper "$root" "$self" || {
      echo "review-sentinel: cannot write $HELPER_REL" >&2
      return 2
    }
    if grep -qF "review-cycle-pre-commit.sh" "$config"; then
      echo "review-sentinel: lefthook job already present in $(basename "$config"); helper refreshed at $HELPER_REL"
      return 0
    fi
    if grep -qE '^pre-commit:' "$config"; then
      cat <<EOF
review-sentinel: helper written to $HELPER_REL.
$(basename "$config") already defines pre-commit; add this job to it manually:

  pre-commit:
    commands:
      review-cycle:
        run: sh -c 'test ! -f $HELPER_REL || sh $HELPER_REL'
EOF
      return 0
    fi
    if ! cat >> "$config" <<EOF

pre-commit:
  commands:
    review-cycle:
      run: sh -c 'test ! -f $HELPER_REL || sh $HELPER_REL'
EOF
    then
      echo "review-sentinel: cannot append to $(basename "$config")" >&2
      return 2
    fi
    echo "review-sentinel: helper written to $HELPER_REL; pre-commit job appended to $(basename "$config") (run 'lefthook install' to activate)"
    return 0
  fi

  # pre-commit (the Python tool): its generated .git/hooks/pre-commit execs
  # the runtime, so appended code is dead, and the file is regenerated by
  # `pre-commit install`. A repo-local hook entry in its committed config
  # is the only correct integration; print it, never auto-edit.
  if [ -f "$root/.pre-commit-config.yaml" ]; then
    write_helper "$root" "$self" || {
      echo "review-sentinel: cannot write $HELPER_REL" >&2
      return 2
    }
    cat <<EOF
review-sentinel: helper written to $HELPER_REL.
This repo uses pre-commit; add this to .pre-commit-config.yaml:

  - repo: local
    hooks:
      - id: review-cycle
        name: review-cycle gate
        entry: sh $HELPER_REL
        language: system
        pass_filenames: false
        stages: [pre-commit]
EOF
    return 0
  fi

  # simple-git-hooks: clobbers .git/hooks on install and supports one
  # command per hook, so chaining must go through its package.json config.
  if [ -f "$root/package.json" ] && grep -q '"simple-git-hooks"' "$root/package.json"; then
    write_helper "$root" "$self" || {
      echo "review-sentinel: cannot write $HELPER_REL" >&2
      return 2
    }
    cat <<EOF
review-sentinel: helper written to $HELPER_REL.
This repo uses simple-git-hooks; chain the gate into its pre-commit in
package.json, e.g.:

  "simple-git-hooks": {
    "pre-commit": "<existing command> && sh $HELPER_REL"
  }

then re-run: npx simple-git-hooks
EOF
    return 0
  fi

  # Plain git — including husky and anything else using core.hooksPath,
  # which --git-path resolves for us (husky hooks are plain shell, so the
  # marker-managed append composes with them).
  hooks_dir=$(git -C "$root" rev-parse --git-path hooks 2>/dev/null) || {
    echo "review-sentinel: cannot resolve hooks dir for $root" >&2
    return 2
  }
  case "$hooks_dir" in
    /*) ;;
    *) hooks_dir="$root/$hooks_dir" ;;
  esac
  mkdir -p "$hooks_dir" || {
    echo "review-sentinel: cannot create $hooks_dir" >&2
    return 2
  }
  target="$hooks_dir/pre-commit"
  # A tracked hook file (husky commits .husky/) is team-owned config;
  # rewriting it would bake a machine-specific path into a committed file
  # and strand the team's hook in an untracked .local. Same rule as the
  # other committed-config managers: helper plus snippet, never auto-edit.
  if [ -f "$target" ] && ! grep -qF "$HOOK_MARK_BEGIN" "$target" \
     && git -C "$root" ls-files --error-unmatch -- "$target" >/dev/null 2>&1; then
    write_helper "$root" "$self" || {
      echo "review-sentinel: cannot write $HELPER_REL" >&2
      return 2
    }
    cat <<EOF
review-sentinel: helper written to $HELPER_REL.
$target is tracked by git (hook-manager config); not auto-editing it.
Add this line to it manually:

  sh -c 'test ! -f $HELPER_REL || sh $HELPER_REL'
EOF
    return 0
  fi
  write_hook_file "$target" "$(hook_block "$self")" || {
    RC=$?
    [ "$RC" -eq 2 ] || echo "review-sentinel: cannot write $target" >&2
    return 2
  }
  echo "review-sentinel: commit-time gate installed at $target"
  return 0
}

# Parse args and dispatch. Kept behind the BASH_SOURCE guard below so the file
# can be sourced (e.g. by bats) to unit-test individual functions without
# running a subcommand.
main() {
  ROOT_OVERRIDE=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --root)
        [ $# -ge 2 ] || usage
        ROOT_OVERRIDE="$2"
        shift 2
        ;;
      -h|--help|help)
        usage
        ;;
      --)
        shift
        break
        ;;
      -*)
        echo "review-sentinel: unknown option: $1" >&2
        usage
        ;;
      *)
        break
        ;;
    esac
  done

  [ $# -ge 1 ] || usage
  CMD="$1"
  shift

  case "$CMD" in
  seed|mark|accept-state)
    PROJECT_ROOT=$(resolve_project_root)
    if [ -z "$PROJECT_ROOT" ]; then
      echo "review-sentinel: not in a git repo" >&2
      exit 1
    fi
    # `mark` is the review cycle's own verb, so it must not double as a
    # self-issued clearance. `seed` and `accept-state` stay unguarded by
    # design: seed baselines a fresh session, and accept-state is the named
    # human escape hatch. See the cycle-start entry in the header for the
    # marker's lifecycle.
    if [ "$CMD" = "mark" ] && [ ! -f "$PROJECT_ROOT/$STATE_DIR/in-progress" ]; then
      echo "review-sentinel: no review in progress; mark is valid only after cycle-start" >&2
      echo "review-sentinel: if a cycle is running, it began without cycle-start, or the Stop gate or SessionStart reaped its marker after the 60-minute TTL — report that in the cycle summary rather than re-running cycle-start to recreate the evidence" >&2
      echo "review-sentinel: to accept a state a human reviewed themselves, use: review-sentinel accept-state" >&2
      exit 3
    fi
    ANCHOR=$(current_anchor "$PROJECT_ROOT")
    HASH=$(compute_hash_from_anchor "$PROJECT_ROOT" "$ANCHOR")
    RC=$?
    if [ $RC -ne 0 ]; then
      echo "review-sentinel: cannot compute hash from anchor $ANCHOR" >&2
      exit 2
    fi
    # A capture failure falls back to the two-line format: the gate keeps
    # working on the legacy hash, only delta scoping and the tree fast path
    # are lost, and the summary-visible stderr line says so.
    TREE=$(capture_worktree_tree "$PROJECT_ROOT") || TREE=""
    # The hash and the tree must describe one state: an edit landing between
    # the two captures would store a tree containing content the hash never
    # vouched for, and check trusts the tree first. Verify the pairing and
    # retry once; a state still moving falls back to hash-only.
    if [ -n "$TREE" ]; then
      HASH2=$(compute_hash_from_anchor "$PROJECT_ROOT" "$ANCHOR")
      if [ $? -ne 0 ] || [ -z "$HASH2" ]; then
        TREE=""
      elif [ "$HASH2" != "$HASH" ]; then
        HASH="$HASH2"
        TREE=$(capture_worktree_tree "$PROJECT_ROOT") || TREE=""
        if [ -n "$TREE" ]; then
          HASH3=$(compute_hash_from_anchor "$PROJECT_ROOT" "$ANCHOR")
          if [ $? -ne 0 ] || [ "$HASH3" != "$HASH" ]; then
            TREE=""
          fi
        fi
      fi
    fi
    if [ -n "$TREE" ]; then
      TREE_REF=$(marked_tree_ref "$PROJECT_ROOT") || TREE_REF=""
      if [ -n "$TREE_REF" ] && git -C "$PROJECT_ROOT" update-ref "$TREE_REF" "$TREE" 2>/dev/null; then
        # The pre-worktree-aware single ref would otherwise pin one stale
        # tree forever.
        git -C "$PROJECT_ROOT" update-ref -d refs/review-cycle/marked-tree 2>/dev/null || true
      else
        TREE=""
      fi
    fi
    [ -n "$TREE" ] || echo "review-sentinel: could not capture the reviewed tree; falling back to hash-only sentinel (no delta scoping until the next successful mark)" >&2
    SENTINEL_CONTENT="anchor:$ANCHOR
$HASH"
    [ -z "$TREE" ] || SENTINEL_CONTENT="$SENTINEL_CONTENT
tree:$TREE"
    write_sentinel "$PROJECT_ROOT/$SENTINEL_REL" "$SENTINEL_CONTENT" || {
      echo "review-sentinel: cannot write sentinel" >&2
      exit 2
    }
    # Any newly written state resolves the recorded blocked-state.
    /bin/rm -f "$PROJECT_ROOT/$STATE_DIR/stop-block"
    [ ! -e "$PROJECT_ROOT/$STATE_DIR/stop-block" ] \
      || echo "review-sentinel: warning: could not remove $STATE_DIR/stop-block; Stop-gate behavior may be stale" >&2
    # Only a verb that concludes a cycle retires its marker: mark completes one,
    # accept-state supersedes it. `seed` does not — it baselines a fresh session
    # and knows nothing about a cycle, and SessionStart may fire while another
    # session in the same repo is mid-review, whose marker its Phase 8 still
    # needs. Revoking an abandoned marker belongs to the TTL owners: the Stop
    # gate and SessionStart's stale-only check.
    if [ "$CMD" != "seed" ]; then
      # Nonzero, not a warning: a written sentinel with the guard still
      # disarmed is not success.
      /bin/rm -f "$PROJECT_ROOT/$STATE_DIR/in-progress"
      if [ -e "$PROJECT_ROOT/$STATE_DIR/in-progress" ]; then
        echo "review-sentinel: sentinel written, but $STATE_DIR/in-progress survived; mark's precondition stays satisfied for unreviewed work until it is removed" >&2
        exit 2
      fi
    fi
    exit 0
    ;;

  check)
    PROJECT_ROOT=$(resolve_project_root)
    [ -n "$PROJECT_ROOT" ] || exit 2
    is_clean_tree "$PROJECT_ROOT" && exit 0
    STORED=$(read_sentinel "$PROJECT_ROOT/$SENTINEL_REL") || exit 1
    [ -n "$STORED" ] || exit 1
    # Tree comparison when the sentinel carries one: content equality is
    # immune to the hunk-header drift that broke the hash when a file's
    # changes were split across a commit (cpl-34d), and it is near-constant
    # in git spawns where the hash is O(changed paths) — measured 0.03s vs
    # 1.47s on 100 dirty files. Any tree-path failure falls back to the hash.
    STORED_TREE=$(read_sentinel_tree "$PROJECT_ROOT/$SENTINEL_REL") || STORED_TREE=""
    if [ -n "$STORED_TREE" ] && git -C "$PROJECT_ROOT" cat-file -e "$STORED_TREE" 2>/dev/null; then
      CURRENT_TREE=$(capture_worktree_tree "$PROJECT_ROOT") || CURRENT_TREE=""
      if [ -n "$CURRENT_TREE" ]; then
        [ "$CURRENT_TREE" = "$STORED_TREE" ] || exit 1
        # Divergent or erroring index state routes to the hash, which alone
        # distinguishes a partial stage the mark saw from staged unreviewed
        # content (measured: exiting 1 here made the former an unclearable
        # false drift that three accept-state calls could not clear).
        ( staged_divergence "$PROJECT_ROOT" ) && exit 0
      fi
    fi
    STORED_ANCHOR=$(echo "$STORED" | sed -n '1p' | sed 's/^anchor://')
    STORED_HASH=$(echo "$STORED" | sed -n '2p')
    CURRENT_HASH=$(compute_hash_from_anchor "$PROJECT_ROOT" "$STORED_ANCHOR")
    RC=$?
    [ $RC -eq 1 ] && exit 2
    [ $RC -eq 2 ] && exit 1  # anchor unreachable: treat as drift
    [ "$CURRENT_HASH" = "$STORED_HASH" ] && exit 0
    exit 1
    ;;

  match)
    PROJECT_ROOT=$(resolve_project_root)
    [ -n "$PROJECT_ROOT" ] || exit 2
    STORED=$(read_sentinel "$PROJECT_ROOT/$SENTINEL_REL") || exit 1
    [ -n "$STORED" ] || exit 1
    STORED_TREE=$(read_sentinel_tree "$PROJECT_ROOT/$SENTINEL_REL") || STORED_TREE=""
    if [ -n "$STORED_TREE" ] && git -C "$PROJECT_ROOT" cat-file -e "$STORED_TREE" 2>/dev/null; then
      CURRENT_TREE=$(capture_worktree_tree "$PROJECT_ROOT") || CURRENT_TREE=""
      if [ -n "$CURRENT_TREE" ]; then
        [ "$CURRENT_TREE" = "$STORED_TREE" ] || exit 1
        # Same routing as check: the hash arbitrates divergent index states.
        ( staged_divergence "$PROJECT_ROOT" ) && exit 0
      fi
    fi
    STORED_ANCHOR=$(echo "$STORED" | sed -n '1p' | sed 's/^anchor://')
    STORED_HASH=$(echo "$STORED" | sed -n '2p')
    CURRENT_HASH=$(compute_hash_from_anchor "$PROJECT_ROOT" "$STORED_ANCHOR")
    RC=$?
    [ $RC -eq 1 ] && exit 2  # real error (no sha tool, no work tree, pipeline failed)
    [ $RC -eq 2 ] && exit 1  # anchor unreachable: cannot match
    [ "$CURRENT_HASH" = "$STORED_HASH" ] && exit 0
    exit 1
    ;;

  delta)
    PROJECT_ROOT=$(resolve_project_root)
    if [ -z "$PROJECT_ROOT" ]; then
      echo "review-sentinel: not in a git repo" >&2
      exit 2
    fi
    STORED_TREE=$(read_sentinel_tree "$PROJECT_ROOT/$SENTINEL_REL") || {
      echo "review-sentinel: no marked tree in the sentinel (pre-0.16 mark, or no mark yet); delta unavailable — scope to the full diff" >&2
      exit 3
    }
    git -C "$PROJECT_ROOT" cat-file -e "$STORED_TREE" 2>/dev/null || {
      echo "review-sentinel: marked tree $STORED_TREE is missing from the object database; delta unavailable — scope to the full diff" >&2
      exit 3
    }
    # The worktree tree cannot see index-only content, so a divergent index
    # would scope reviewers away from the one thing that needs review.
    ( staged_divergence "$PROJECT_ROOT" )
    case $? in
      1)
        echo "review-sentinel: the index stages content that is in neither the working tree nor HEAD; the delta cannot represent it — scope to the full diff" >&2
        exit 4 ;;
      2)
        echo "review-sentinel: the divergence probe failed; cannot vouch for the index — scope to the full diff" >&2
        exit 2 ;;
    esac
    SCRATCH=$(mktemp) || {
      echo "review-sentinel: mktemp failed; delta unavailable" >&2
      exit 2
    }
    /bin/rm -f "$SCRATCH"
    ( build_worktree_tree "$PROJECT_ROOT" "$SCRATCH" >/dev/null ) || {
      /bin/rm -f "$SCRATCH"
      echo "review-sentinel: could not capture the current tree; delta unavailable" >&2
      exit 2
    }
    NAMESTAT=$( cd "$PROJECT_ROOT" && GIT_INDEX_FILE="$SCRATCH" git diff --cached --name-status "$STORED_TREE" -- ) || {
      /bin/rm -f "$SCRATCH"
      echo "review-sentinel: diff against the marked tree failed" >&2
      exit 2
    }
    NUMSTAT=$( cd "$PROJECT_ROOT" && GIT_INDEX_FILE="$SCRATCH" git diff --cached --numstat "$STORED_TREE" -- ) || {
      /bin/rm -f "$SCRATCH"
      echo "review-sentinel: numstat against the marked tree failed" >&2
      exit 2
    }
    /bin/rm -f "$SCRATCH"
    SUMMARY=$(printf '%s\n' "$NUMSTAT" | awk 'NF {f+=1; a+=$1; d+=$2} END {printf "delta: %d files, +%d -%d\n", f, a, d}') || {
      echo "review-sentinel: delta summary generation failed" >&2
      exit 2
    }
    # Buffered until everything succeeded, then written checked: a partial
    # list with exit 0 would scope reviewers from incomplete output
    # (measured against /dev/full: unchecked printf statuses vanish).
    if [ -n "$NAMESTAT" ]; then
      printf '%s\n' "$NAMESTAT" || { echo "review-sentinel: delta output write failed" >&2; exit 2; }
    fi
    printf '%s\n%s\n' "--" "$SUMMARY" || { echo "review-sentinel: delta output write failed" >&2; exit 2; }
    exit 0
    ;;

  current-hash)
    PROJECT_ROOT=$(resolve_project_root)
    if [ -z "$PROJECT_ROOT" ]; then
      echo "review-sentinel: not in a git repo" >&2
      exit 1
    fi
    ANCHOR=$(current_anchor "$PROJECT_ROOT")
    HASH=$(compute_hash_from_anchor "$PROJECT_ROOT" "$ANCHOR") || exit 2
    printf 'anchor:%s\n%s\n' "$ANCHOR" "$HASH"
    exit 0
    ;;

  cycle-start|pr-cycle-start)
    PROJECT_ROOT=$(resolve_project_root)
    if [ -z "$PROJECT_ROOT" ]; then
      echo "review-sentinel: not in a git repo" >&2
      exit 1
    fi
    MARKER=$(marker_for "$CMD")
    mkdir -p "$PROJECT_ROOT/$STATE_DIR" 2>/dev/null || {
      echo "review-sentinel: cannot create $STATE_DIR dir" >&2
      exit 2
    }
    date +%s > "$PROJECT_ROOT/$STATE_DIR/$MARKER" || {
      # The redirect may have created an empty file before failing; a
      # reported failure must leave no state behind.
      /bin/rm -f "$PROJECT_ROOT/$STATE_DIR/$MARKER" 2>/dev/null
      echo "review-sentinel: cannot write $MARKER" >&2
      exit 2
    }
    exit 0
    ;;

  cycle-end|pr-cycle-end)
    PROJECT_ROOT=$(resolve_project_root)
    if [ -z "$PROJECT_ROOT" ]; then
      echo "review-sentinel: not in a git repo" >&2
      exit 1
    fi
    MARKER=$(marker_for "$CMD")
    /bin/rm -f "$PROJECT_ROOT/$STATE_DIR/$MARKER"
    if [ -e "$PROJECT_ROOT/$STATE_DIR/$MARKER" ]; then
      echo "review-sentinel: cannot remove $MARKER (see the error above); Stop gate stays open until its TTL" >&2
      exit 2
    fi
    exit 0
    ;;

  status)
    PROJECT_ROOT=$(resolve_project_root)
    if [ -z "$PROJECT_ROOT" ]; then
      echo "review-sentinel: not in a git repo" >&2
      exit 2
    fi
    SENTINEL="$PROJECT_ROOT/$SENTINEL_REL"
    STORED_HASH=""
    CURRENT_HASH=""
    HASH_RC=0
    echo "root:    $PROJECT_ROOT"
    CLEAN=no
    is_clean_tree "$PROJECT_ROOT" && CLEAN=yes
    echo "clean:   $CLEAN"
    if [ -f "$PROJECT_ROOT/$STATE_DIR/in-progress" ]; then
      # Line 1 only, matching how the Stop gate reads it.
      TS=$(sed -n '1p' "$PROJECT_ROOT/$STATE_DIR/in-progress" 2>/dev/null | tr -cd '0-9')
      NOWS=$(date +%s 2>/dev/null | tr -cd '0-9')
      if [ -n "$TS" ] && [ -n "$NOWS" ]; then
        AGE=$((NOWS - TS))
        if [ "$AGE" -ge 0 ] && [ "$AGE" -lt 3600 ]; then
          echo "cycle:   in-progress marker present (age ${AGE}s of 3600s TTL; Stop gate passes while fresh)"
        else
          echo "cycle:   in-progress marker present but stale (age ${AGE}s; Stop gate will remove it)"
        fi
      else
        echo "cycle:   in-progress marker present (unreadable timestamp; Stop gate will remove it)"
      fi
    else
      echo "cycle:   no in-progress marker (mark will refuse with exit 3; accept-state records a state you reviewed yourself)"
    fi
    if [ -f "$PROJECT_ROOT/$STATE_DIR/pr-in-progress" ]; then
      echo "pr:      review-pr marker present (holds the Stop gate open; does not license mark)"
    fi
    if [ -f "$PROJECT_ROOT/$STATE_DIR/stop-block" ]; then
      echo "stop:    block-once record present (Stop gate soft-passes while this state is unchanged)"
    fi
    if [ ! -f "$SENTINEL" ]; then
      echo "mark:    missing (no state has been marked reviewed)"
    elif ! STORED=$(read_sentinel "$SENTINEL") || [ -z "$STORED" ]; then
      echo "mark:    malformed (treated as drift)"
    else
      STORED_ANCHOR=$(echo "$STORED" | sed -n '1p' | sed 's/^anchor://')
      STORED_HASH=$(echo "$STORED" | sed -n '2p')
      echo "mark:    anchor=$STORED_ANCHOR"
      echo "         $STORED_HASH"
      if STORED_TREE=$(read_sentinel_tree "$SENTINEL"); then
        if git -C "$PROJECT_ROOT" cat-file -e "$STORED_TREE" 2>/dev/null; then
          CURRENT_TREE=$(capture_worktree_tree "$PROJECT_ROOT") || CURRENT_TREE=""
          if [ -z "$CURRENT_TREE" ]; then
            echo "tree:    $STORED_TREE (capture failed this run; hash path in effect)"
          else
            echo "tree:    $STORED_TREE (delta scoping available)"
            if [ "$CURRENT_TREE" = "$STORED_TREE" ]; then
              # Divergent or erroring index state falls to the hash verdict,
              # matching check's routing.
              ( staged_divergence "$PROJECT_ROOT" ) && TREE_VERDICT="match"
            else
              TREE_VERDICT="drift"
            fi
          fi
        else
          echo "tree:    $STORED_TREE unreachable (object pruned; re-mark to restore delta scoping)"
          STORED_TREE=""
        fi
      else
        STORED_TREE=""
        echo "tree:    none (pre-0.16 mark; delta scoping unavailable)"
      fi
      CURRENT_HASH=$(compute_hash_from_anchor "$PROJECT_ROOT" "$STORED_ANCHOR")
      HASH_RC=$?
      case $HASH_RC in
        0) echo "current: $CURRENT_HASH" ;;
        2) echo "current: (anchor unreachable or a git failure while diffing — treated as drift)" ;;
        *) echo "current: (hash computation failed — gates fail open)" ;;
      esac
    fi
    # Verdict mirrors check: clean tree, then tree comparison, then hash.
    if [ "$CLEAN" = yes ]; then
      echo "verdict: clean tree — gates pass"
      exit 0
    fi
    case "${TREE_VERDICT:-}" in
      match)
        echo "verdict: match — working-tree content equals the marked tree; gates pass"
        exit 0 ;;
      drift)
        echo "verdict: drift — working-tree content differs from the marked tree. Review (/review-cycle:review) or re-mark (/review-cycle:accept) if already reviewed. Run the delta verb to see exactly what changed since the mark."
        exit 1 ;;
    esac
    if [ "$HASH_RC" -eq 1 ]; then
      echo "verdict: error — cannot compute current hash; gates fail open"
      exit 2
    fi
    if [ -n "$STORED_HASH" ] && [ "$CURRENT_HASH" = "$STORED_HASH" ]; then
      echo "verdict: match — this exact state was marked reviewed; gates pass"
      exit 0
    fi
    echo "verdict: drift — state differs from the last mark. Review (/review-cycle:review) or re-mark (/review-cycle:accept) if already reviewed. Common causes when a review DID happen: edits after marking, commit-time formatters, hook managers restoring the index."
    exit 1
    ;;

  paths)
    echo ".claude/review-cycle/"
    echo ".claude/.no-review-gate"
    exit 0
    ;;

  install-hook)
    PROJECT_ROOT=$(resolve_project_root)
    if [ -z "$PROJECT_ROOT" ]; then
      echo "review-sentinel: not in a git repo" >&2
      exit 1
    fi
    SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
    install_hook "$PROJECT_ROOT" "$SELF"
    exit $?
    ;;

  uninstall-hook)
    PROJECT_ROOT=$(resolve_project_root)
    if [ -z "$PROJECT_ROOT" ]; then
      echo "review-sentinel: not in a git repo" >&2
      exit 1
    fi
    uninstall_hook "$PROJECT_ROOT"
    exit $?
    ;;

  *)
    echo "review-sentinel: unknown subcommand: $CMD" >&2
    usage
    ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  main "$@"
fi
